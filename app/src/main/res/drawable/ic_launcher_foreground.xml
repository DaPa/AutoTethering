				<gradient
					android:startX="64"
					android:startY="58"
					android:endX="101"
					android:endY="65"
					android:type="linear">
					<item android:offset="0.0" android:color="#33000000" />
					<item android:offset="1.0" android:color="#00000000" />
				</gradient>
